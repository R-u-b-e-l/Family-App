<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             xmlns:dto="clr-namespace:FamilyManagement.Shared.Dtos;assembly=FamilyManagement.Shared"
             x:Class="FamilyManagement.Maui.Views.RolesPage"
             x:DataType="vm:RolesViewModel"
             Style="{StaticResource AppPage}"
             Title="Roles &amp; Permissions">
    <Grid Padding="16,8,16,0">
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}"
                     RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding Roles}" SelectionMode="None">
                <CollectionView.Header>
                    <Label Text="কোন role-এ কী permission — ট্যাপ করে ঠিক করুন। Member-কে role দিতে Members পেজে যান।"
                           Style="{StaticResource MutedText}" Margin="4,0,4,10" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:RoleDto">
                        <Grid Padding="0,3">
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenRoleCommand, Source={RelativeSource AncestorType={x:Type vm:RolesViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding Description}" Style="{StaticResource MutedText}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Style="{StaticResource MutedText}" FontSize="11">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} জন member · {1} টি permission">
                                                    <Binding Path="MemberCount" />
                                                    <Binding Path="Permissions.Count" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="›" FontSize="20" Style="{StaticResource MutedText}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="90" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <Button Text="＋" FontSize="26" WidthRequest="60" HeightRequest="60" CornerRadius="30"
                BackgroundColor="{StaticResource Primary}" TextColor="White"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,8,16"
                Command="{Binding NewRoleCommand}" />
    </Grid>
</ContentPage>
