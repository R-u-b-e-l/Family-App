<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             xmlns:dto="clr-namespace:FamilyManagement.Shared.Dtos;assembly=FamilyManagement.Shared"
             x:Class="FamilyManagement.Maui.Views.BalanceSheetPage"
             x:DataType="vm:BalanceSheetViewModel"
             Style="{StaticResource AppPage}"
             Title="Balance Sheet">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="📄 PDF" Command="{Binding DownloadPdfCommand}" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,20" Spacing="12">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Style="{StaticResource InputWrap}" Padding="8,0">
                    <DatePicker Date="{Binding AsOf}" />
                </Border>
                <Button Grid.Column="1" Text="Go" Style="{StaticResource PrimaryButton}" HeightRequest="44"
                        WidthRequest="60" Command="{Binding GenerateCommand}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Report, TargetNullValue=False, FallbackValue=False}">
                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Total Assets" Style="{StaticResource MutedText}" />
                        <Label Text="{Binding Report.TotalAssets, Converter={StaticResource Money}}"
                               Style="{StaticResource AmountText}" FontSize="17" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Liabilities + Equity" Style="{StaticResource MutedText}" />
                        <Label Style="{StaticResource AmountText}" FontSize="17">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0:N2}">
                                    <Binding Path="Report.TotalLiabilities" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" IsVisible="{Binding Report, TargetNullValue=False, FallbackValue=False}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Assets" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Report.AssetLines}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:ReportLineDto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding AccountName}" Style="{StaticResource BodyText}" />
                                    <Label Grid.Column="1" Text="{Binding Amount, StringFormat='{0:N2}'}" Style="{StaticResource BodyText}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Total Assets" Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold" />
                        <Label Grid.Column="1" Text="{Binding Report.TotalAssets, StringFormat='{0:N2}'}"
                               Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding Report, TargetNullValue=False, FallbackValue=False}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Liabilities" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Report.LiabilityLines}" Spacing="4">
                        <BindableLayout.EmptyView>
                            <Label Text="No liabilities." Style="{StaticResource MutedText}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:ReportLineDto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding AccountName}" Style="{StaticResource BodyText}" />
                                    <Label Grid.Column="1" Text="{Binding Amount, StringFormat='{0:N2}'}" Style="{StaticResource BodyText}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Total Liabilities" Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold" />
                        <Label Grid.Column="1" Text="{Binding Report.TotalLiabilities, StringFormat='{0:N2}'}"
                               Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding Report, TargetNullValue=False, FallbackValue=False}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Equity" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Report.EquityLines}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:ReportLineDto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding AccountName}" Style="{StaticResource BodyText}" />
                                    <Label Grid.Column="1" Text="{Binding Amount, StringFormat='{0:N2}'}" Style="{StaticResource BodyText}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Total Equity" Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold" />
                        <Label Grid.Column="1" Text="{Binding Report.TotalEquity, StringFormat='{0:N2}'}"
                               Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
