<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             x:Class="FamilyManagement.Maui.Views.LoanEntryPage"
             x:DataType="vm:LoanEntryViewModel"
             Style="{StaticResource AppPage}"
             Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="4">

            <Label Text="কোন Member?" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}" Padding="8,0">
                <Picker ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}"
                        ItemDisplayBinding="{Binding FullName}" Title="Member বেছে নিন…" />
            </Border>

            <Label Text="টাকার পরিমাণ" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="0.00"
                       FontSize="24" HorizontalTextAlignment="Center" FontAttributes="Bold" />
            </Border>

            <Label Text="Cash / Bank" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}" Padding="8,0">
                <Picker ItemsSource="{Binding MoneyAccounts}" SelectedItem="{Binding MoneyAccount}"
                        ItemDisplayBinding="{Binding Name}" Title="বেছে নিন…" />
            </Border>

            <Label Text="তারিখ" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}" Padding="8,0">
                <DatePicker Date="{Binding Date}" />
            </Border>

            <Label Text="বিবরণ (optional)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Narration}" Placeholder="যেমন: চিকিৎসার জন্য" />
            </Border>

            <Button Text="{Binding ActionText}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
