<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             x:Class="FamilyManagement.Maui.Views.FamilySettingsPage"
             x:DataType="vm:FamilySettingsViewModel"
             Style="{StaticResource AppPage}"
             Title="Family Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,24" Spacing="4">

            <Label Text="Currency (ISO code)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Currency}" MaxLength="3" Placeholder="BDT" />
            </Border>

            <Label Text="Financial Year Start Month (1–12)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding FinancialYearStartMonth}" Keyboard="Numeric" />
            </Border>

            <Label Text="Date Format" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding DateFormat}" Placeholder="dd-MMM-yyyy" />
            </Border>

            <Label Text="Timezone" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Timezone}" Placeholder="Asia/Dhaka" />
            </Border>

            <Label Text="Address" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Address}" />
            </Border>

            <Label Text="Contact Phone" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding ContactPhone}" Keyboard="Telephone" />
            </Border>

            <Label Text="Contact Email" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding ContactEmail}" Keyboard="Email" />
            </Border>

            <Button Text="Save Settings" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
