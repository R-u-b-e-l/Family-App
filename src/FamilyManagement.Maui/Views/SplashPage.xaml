<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FamilyManagement.Maui.Views.SplashPage"
             Style="{StaticResource AppPage}"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="18">
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" BackgroundColor="White"
                WidthRequest="112" HeightRequest="112" Padding="12">
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.12" Radius="10" Offset="0,4" />
            </Border.Shadow>
            <Image Source="familylogo.png" Aspect="AspectFit" />
        </Border>
        <Label Text="Family Manager" Style="{StaticResource PageTitle}" HorizontalOptions="Center" />
        <Label Text="Family finances, done right" Style="{StaticResource MutedText}" HorizontalOptions="Center" />
        <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" Margin="0,24,0,0" />
    </VerticalStackLayout>
</ContentPage>
