<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             xmlns:dto="clr-namespace:FamilyManagement.Shared.Dtos;assembly=FamilyManagement.Shared"
             x:Class="FamilyManagement.Maui.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Style="{StaticResource AppPage}"
             Title="Notifications">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mark all read" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}"
                 RefreshColor="{StaticResource Primary}">
        <CollectionView ItemsSource="{Binding Notifications}" SelectionMode="None" Margin="16,8">
            <CollectionView.EmptyView>
                <VerticalStackLayout Margin="0,40" Spacing="8">
                    <Label Text="🔕" FontSize="38" HorizontalOptions="Center" />
                    <Label Text="No notifications yet" Style="{StaticResource MutedText}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:NotificationDto">
                    <Grid Padding="0,3">
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center"
                                         Color="{StaticResource Primary}"
                                         IsVisible="{Binding IsRead, Converter={StaticResource InverseBool}}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyText}"
                                           FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding Body}" Style="{StaticResource MutedText}"
                                           IsVisible="{Binding Body, TargetNullValue=False, FallbackValue=False}" />
                                    <Label Text="{Binding CreatedDate, StringFormat='{0:dd MMM yyyy, hh:mm tt}'}"
                                           Style="{StaticResource MutedText}" FontSize="11" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
