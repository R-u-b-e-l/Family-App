<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             xmlns:dto="clr-namespace:FamilyManagement.Shared.Dtos;assembly=FamilyManagement.Shared"
             xmlns:controls="clr-namespace:FamilyManagement.Maui.Controls"
             x:Class="FamilyManagement.Maui.Views.MyDashboardPage"
             x:DataType="vm:MyDashboardViewModel"
             Style="{StaticResource AppPage}"
             Title="{Binding Heading}">
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}"
                 RefreshColor="{StaticResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="16,12,16,24" Spacing="12">

                <!-- Contribution / Expense cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="মোট দিয়েছি (Contribution)" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding Statement.TotalContribution, Converter={StaticResource Money}}"
                                   Style="{StaticResource AmountText}" TextColor="{StaticResource Success}" FontSize="17" />
                            <Label Text="{Binding Statement.MonthContribution, Converter={StaticResource Money}, StringFormat='এ মাসে: {0}'}"
                                   Style="{StaticResource MutedText}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="মোট খরচ (Expense)" Style="{StaticResource MutedText}" />
                            <Label Text="{Binding Statement.TotalExpense, Converter={StaticResource Money}}"
                                   Style="{StaticResource AmountText}" TextColor="{StaticResource Danger}" FontSize="17" />
                            <Label Text="{Binding Statement.MonthExpense, Converter={StaticResource Money}, StringFormat='এ মাসে: {0}'}"
                                   Style="{StaticResource MutedText}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Loan card -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenLoanStatementCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💳 Loan (ঋণ)" Style="{StaticResource SectionTitle}" />
                            <Label Style="{StaticResource MutedText}">
                                <Label.Text>
                                    <MultiBinding StringFormat="নিয়েছি {0:N2} · শোধ {1:N2}">
                                        <Binding Path="Statement.LoanTaken" />
                                        <Binding Path="Statement.LoanRepaid" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                            <Label Text="বাকি আছে" Style="{StaticResource MutedText}" HorizontalOptions="End" />
                            <Label Text="{Binding Statement.LoanOutstanding, Converter={StaticResource Money}}"
                                   Style="{StaticResource AmountText}" TextColor="{StaticResource Warning}" FontSize="18"
                                   HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Monthly chart -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Label Text="মাসভিত্তিক হিসাব" Style="{StaticResource SectionTitle}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="2"
                                         Color="{StaticResource Success}" VerticalOptions="Center" />
                                <Label Text="দিয়েছি" Style="{StaticResource MutedText}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="2"
                                         Color="{StaticResource Danger}" VerticalOptions="Center" />
                                <Label Text="খরচ" Style="{StaticResource MutedText}" />
                            </HorizontalStackLayout>
                        </Grid>
                        <controls:BarChartView ItemsSource="{Binding Monthly}"
                                               LabelColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Expense donut -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="আমার খরচ কোথায় গেল (এ মাসে)" Style="{StaticResource SectionTitle}" />
                        <controls:DonutChartView ItemsSource="{Binding ExpenseCategories}"
                                                 LabelColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Transactions -->
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <Label Text="আমার সব লেনদেন" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" Text="{Binding Statement.TransactionCount, StringFormat='{0} টি'}"
                                   Style="{StaticResource MutedText}" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Transactions}">
                            <BindableLayout.EmptyView>
                                <Label Text="এখনো কোনো লেনদেন নেই।" Style="{StaticResource MutedText}"
                                       Margin="0,10" HorizontalOptions="Center" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:VoucherListItemDto">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenTransactionCommand, Source={RelativeSource AncestorType={x:Type vm:MyDashboardViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{Binding VoucherType, Converter={StaticResource VoucherTypeColor}}"
                                                WidthRequest="40" HeightRequest="40">
                                            <Label Text="{Binding VoucherType}" TextColor="White" FontSize="11"
                                                   FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Narration, TargetNullValue='(no narration)'}"
                                                   Style="{StaticResource BodyText}" LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Label Style="{StaticResource MutedText}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1}">
                                                        <Binding Path="VoucherNumber" />
                                                        <Binding Path="VoucherDate" Converter="{StaticResource DateOnlyFormat}" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Amount, Converter={StaticResource Money}}"
                                               Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="আরও দেখুন" Style="{StaticResource LinkButton}" Command="{Binding LoadMoreCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="+ নতুন লেনদেন" Style="{StaticResource PrimaryButton}" Command="{Binding NewEntryCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
