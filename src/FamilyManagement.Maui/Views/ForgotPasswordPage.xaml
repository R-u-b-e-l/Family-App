<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             x:Class="FamilyManagement.Maui.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Style="{StaticResource AppPage}"
             Title="Reset Password">
    <ScrollView>
        <VerticalStackLayout Padding="24,24" Spacing="6">

            <!-- Step 1: identifier -->
            <VerticalStackLayout IsVisible="{Binding IsIdentifierStep}" Spacing="6">
                <Label Text="Forgot your password?" Style="{StaticResource PageTitle}" />
                <Label Text="Enter your email or mobile and we'll send a 6-digit code."
                       Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                <Border Style="{StaticResource InputWrap}">
                    <Entry Text="{Binding Identifier}" Placeholder="Email or mobile" Keyboard="Email" />
                </Border>
                <Button Text="Send Code" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                        Command="{Binding SendOtpCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </VerticalStackLayout>

            <!-- Step 2: OTP -->
            <VerticalStackLayout IsVisible="{Binding IsOtpStep}" Spacing="6">
                <Label Text="Enter the code" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding Identifier, StringFormat='We sent a 6-digit code to {0}. It expires in 5 minutes.'}"
                       Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                <Border Style="{StaticResource InputWrap}">
                    <Entry Text="{Binding Otp}" Placeholder="6-digit code" Keyboard="Numeric" MaxLength="6"
                           HorizontalTextAlignment="Center" FontSize="22" />
                </Border>
                <Button Text="Verify Code" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                        Command="{Binding VerifyOtpCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Text="Resend code" Style="{StaticResource LinkButton}" Command="{Binding ResendCommand}" />
            </VerticalStackLayout>

            <!-- Step 3: new password -->
            <VerticalStackLayout IsVisible="{Binding IsResetStep}" Spacing="6">
                <Label Text="Set a new password" Style="{StaticResource PageTitle}" />
                <Label Text="Password" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputWrap}">
                    <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="At least 8 characters, 1 digit" />
                </Border>
                <Label Text="Confirm Password" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputWrap}">
                    <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Repeat the password" />
                </Border>
                <Button Text="Reset Password" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                        Command="{Binding ResetPasswordCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" Margin="0,10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
