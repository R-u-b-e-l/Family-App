<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             x:Class="FamilyManagement.Maui.Views.QuickVoucherPage"
             x:DataType="vm:QuickVoucherViewModel"
             Style="{StaticResource AppPage}"
             Title="New Entry">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,24" Spacing="8">

            <!-- Mode selector -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="💸 খরচ" Command="{Binding SetModeCommand}" CommandParameter="0"
                        CornerRadius="12" HeightRequest="52" FontFamily="OpenSansSemibold"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsExpense}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="💰 আয়" Command="{Binding SetModeCommand}" CommandParameter="1"
                        CornerRadius="12" HeightRequest="52" FontFamily="OpenSansSemibold"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsIncome}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="🔁 Transfer" Command="{Binding SetModeCommand}" CommandParameter="2"
                        CornerRadius="12" HeightRequest="52" FontFamily="OpenSansSemibold"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsTransfer}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Info}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Hint -->
            <Border Style="{StaticResource Card}" Padding="12,10" BackgroundColor="{StaticResource Secondary}">
                <Label Text="{Binding ExplainText}" FontSize="12.5" TextColor="{StaticResource SecondaryDarkText}" />
            </Border>

            <!-- Amount (big and friendly) -->
            <Label Text="টাকার পরিমাণ (Amount)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="0.00"
                       FontSize="26" HorizontalTextAlignment="Center" FontAttributes="Bold" />
            </Border>

            <!-- Expense / Income fields -->
            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsTransfer, Converter={StaticResource InverseBool}}">
                <Label Text="{Binding CategoryLabel}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputWrap}" Padding="8,0">
                    <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                            ItemDisplayBinding="{Binding Name}" Title="বেছে নিন…" />
                </Border>

                <Label Text="{Binding MoneyLabel}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputWrap}" Padding="8,0">
                    <Picker ItemsSource="{Binding MoneyAccounts}" SelectedItem="{Binding MoneyAccount}"
                            ItemDisplayBinding="{Binding Name}" Title="Cash / Bank বেছে নিন…" />
                </Border>
            </VerticalStackLayout>

            <!-- Transfer fields -->
            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsTransfer}">
                <Label Text="কোথা থেকে (From)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputWrap}" Padding="8,0">
                    <Picker ItemsSource="{Binding MoneyAccounts}" SelectedItem="{Binding TransferFrom}"
                            ItemDisplayBinding="{Binding Name}" Title="বেছে নিন…" />
                </Border>
                <Label Text="কোথায় (To)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputWrap}" Padding="8,0">
                    <Picker ItemsSource="{Binding MoneyAccounts}" SelectedItem="{Binding TransferTo}"
                            ItemDisplayBinding="{Binding Name}" Title="বেছে নিন…" />
                </Border>
            </VerticalStackLayout>

            <Label Text="কার লেনদেন? (Member)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}" Padding="8,0">
                <Picker ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}"
                        ItemDisplayBinding="{Binding FullName}" Title="Member বেছে নিন…" />
            </Border>

            <Label Text="তারিখ (Date)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}" Padding="8,0">
                <DatePicker Date="{Binding Date}" />
            </Border>

            <Label Text="বিবরণ (Note — না দিলেও চলবে)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Narration}" Placeholder="যেমন: রুবেল - অক্টোবরের টাকা" />
            </Border>

            <Button Text="✓ সেভ করুন" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" FontSize="17"
                    HeightRequest="56" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />

            <Button Text="Advanced entry (multi-line / JV)" Style="{StaticResource LinkButton}"
                    Command="{Binding OpenAdvancedCommand}" Margin="0,4,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
