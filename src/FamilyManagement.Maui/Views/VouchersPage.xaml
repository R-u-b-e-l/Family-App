<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             xmlns:dto="clr-namespace:FamilyManagement.Shared.Dtos;assembly=FamilyManagement.Shared"
             x:Class="FamilyManagement.Maui.Views.VouchersPage"
             x:DataType="vm:VouchersViewModel"
             Style="{StaticResource AppPage}"
             Title="Vouchers">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0" RowSpacing="8">

        <Border Style="{StaticResource InputWrap}">
            <Entry Text="{Binding Search}" Placeholder="Search number or narration…"
                   ClearButtonVisibility="WhileEditing" />
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Style="{StaticResource InputWrap}" Padding="8,0">
                <Picker SelectedIndex="{Binding TypeFilterIndex}" Title="Type">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>All Types</x:String>
                            <x:String>Journal</x:String>
                            <x:String>Payment</x:String>
                            <x:String>Receipt</x:String>
                            <x:String>Contra</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource InputWrap}" Padding="8,0">
                <Picker SelectedIndex="{Binding StatusFilterIndex}" Title="Status">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>All Status</x:String>
                            <x:String>Draft</x:String>
                            <x:String>Posted</x:String>
                            <x:String>Cancelled</x:String>
                            <x:String>Reversed</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>
        </Grid>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}"
                     RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding Vouchers}" SelectionMode="None"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Margin="0,40" Spacing="8">
                        <Label Text="🧾" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="No vouchers found" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />
                        <Label Text="Tap + to record your first transaction." Style="{StaticResource MutedText}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:VoucherListItemDto">
                        <Grid Padding="0,3">
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenVoucherCommand, Source={RelativeSource AncestorType={x:Type vm:VouchersViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{Binding VoucherType, Converter={StaticResource VoucherTypeColor}}"
                                            WidthRequest="42" HeightRequest="42">
                                        <Label Text="{Binding VoucherType}" TextColor="White" FontSize="11"
                                               FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Narration, TargetNullValue='(no narration)'}"
                                               Style="{StaticResource BodyText}" LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Style="{StaticResource MutedText}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="VoucherNumber" />
                                                    <Binding Path="VoucherDate" Converter="{StaticResource DateOnlyFormat}" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Amount, Converter={StaticResource Money}}"
                                               Style="{StaticResource BodyText}" FontFamily="OpenSansSemibold"
                                               HorizontalOptions="End" />
                                        <Border Style="{StaticResource Chip}" HorizontalOptions="End"
                                                BackgroundColor="{Binding Status, Converter={StaticResource VoucherStatusColor}}">
                                            <Label Text="{Binding Status}" TextColor="White" FontSize="10" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="90" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2" Text="＋" FontSize="26" WidthRequest="60" HeightRequest="60" CornerRadius="30"
                BackgroundColor="{StaticResource Primary}" TextColor="White"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,8,16"
                Command="{Binding NewVoucherCommand}" IsVisible="{Binding CanCreate}" />
    </Grid>
</ContentPage>
