<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyManagement.Maui.ViewModels"
             x:Class="FamilyManagement.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Style="{StaticResource AppPage}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="8" VerticalOptions="Center">

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" BackgroundColor="White"
                    WidthRequest="96" HeightRequest="96" HorizontalOptions="Center" Margin="0,0,0,8" Padding="10">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.12" Radius="10" Offset="0,4" />
                </Border.Shadow>
                <Image Source="familylogo.png" Aspect="AspectFit" />
            </Border>

            <Label Text="Welcome back" Style="{StaticResource PageTitle}" HorizontalOptions="Center" />
            <Label Text="Sign in to your family account" Style="{StaticResource MutedText}" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Label Text="Username / Email / Mobile" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Identifier}" Placeholder="e.g. rubel or rubel@mail.com" Keyboard="Email" />
            </Border>

            <Label Text="Password" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding Password}" Placeholder="Your password" IsPassword="True" />
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="4,8,0,4">
                <HorizontalStackLayout Spacing="6">
                    <CheckBox IsChecked="{Binding RememberMe}" Color="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Text="Remember me" Style="{StaticResource BodyText}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button Grid.Column="1" Text="Forgot password?" Style="{StaticResource LinkButton}"
                        Command="{Binding GoToForgotPasswordCommand}" />
            </Grid>

            <Button Text="Sign In" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />

            <BoxView Style="{StaticResource Divider}" Margin="0,16" />

            <Label Text="New here?" Style="{StaticResource MutedText}" HorizontalOptions="Center" />
            <Button Text="Create a Family Account" Style="{StaticResource OutlineButton}"
                    Command="{Binding GoToRegisterCommand}" />

            <BoxView Style="{StaticResource Divider}" Margin="0,16" />

            <Label Text="Server Address (your PC's IP)" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource InputWrap}">
                <Entry Text="{Binding ServerUrl}" Placeholder="http://192.168.211.50:5005" Keyboard="Url" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
